---
import '../styles/global.css';
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<!-- La clase scroll-smooth habilita el desplazamiento suave nativo -->
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Portfolio de Martín - Backend Developer" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon2.png" />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
	</head>
	<body class="bg-zinc-950 text-zinc-300 font-['Inter'] antialiased selection:bg-blue-600 selection:text-white">
		
		<!-- NAVBAR STICKY -->
		<nav class="sticky top-0 z-50 w-full backdrop-blur-md bg-zinc-950/80 border-b border-zinc-800">
			<!-- Barra de progreso de lectura (scroll) -->
			<div class="absolute bottom-0 left-0 w-full h-[2px] bg-transparent">
				<div id="scroll-progress" class="h-full bg-blue-500 w-0 transition-all duration-75 ease-out shadow-[0_0_8px_rgba(59,130,246,0.6)]"></div>
			</div>

			<div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-center relative">
				
				<!-- Links de Navegación (Desktop) -->
				<div class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400">
					<a href="#inicio" class="nav-link hover:text-zinc-100 transition-colors">Inicio</a>
					<a href="#sobre-mi" class="nav-link hover:text-zinc-100 transition-colors">Sobre Mí</a>
					<a href="#stack" class="nav-link hover:text-zinc-100 transition-colors">Stack Tecnológico</a>
					<a href="#proyectos" class="nav-link hover:text-zinc-100 transition-colors">Proyectos</a>
					<a href="#educacion" class="nav-link hover:text-zinc-100 transition-colors">Educación</a>
					<a href="#contacto" class="nav-link hover:text-zinc-100 transition-colors">Contacto</a>
				</div>

				<!-- Botón Contacto y Menú Hamburguesa (Mobile) -->
				<div class="flex items-center gap-4 md:hidden absolute right-6">
					<a href="#contacto" class="text-xs font-medium bg-blue-600/10 text-blue-400 border border-blue-500/20 px-3 py-1.5 rounded hover:bg-blue-600/20 transition-colors">
						Contactar
					</a>
					<button id="mobile-menu-btn" class="text-zinc-400 hover:text-zinc-100 p-1">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
					</button>
				</div>
			</div>

			<!-- Menú Desplegable (Mobile) -->
			<div id="mobile-menu" class="hidden md:hidden bg-zinc-950 border-b border-zinc-800 px-6 py-4 absolute w-full shadow-xl">
				<div class="flex flex-col gap-4 text-sm font-medium text-zinc-400">
					<a href="#inicio" class="nav-link hover:text-zinc-100 transition-colors mobile-link block w-full">Inicio</a>
					<a href="#sobre-mi" class="nav-link hover:text-zinc-100 transition-colors mobile-link block w-full">Sobre Mí</a>
					<a href="#stack" class="nav-link hover:text-zinc-100 transition-colors mobile-link block w-full">Stack Tecnológico</a>
					<a href="#proyectos" class="nav-link hover:text-zinc-100 transition-colors mobile-link block w-full">Proyectos</a>
					<a href="#educacion" class="nav-link hover:text-zinc-100 transition-colors mobile-link block w-full">Educación</a>
					<a href="#contacto" class="nav-link hover:text-zinc-100 transition-colors mobile-link block w-full">Contacto</a>
				</div>
			</div>
		</nav>

		<!-- Contenedor Principal de la Página -->
		<main class="max-w-4xl mx-auto px-6 py-12 md:py-16">
			<slot />
		</main>

		<!-- Script para el menú de Mobile -->
		<script>
			const btn = document.getElementById('mobile-menu-btn');
			const menu = document.getElementById('mobile-menu');
			const links = document.querySelectorAll('.mobile-link');

			// Abrir/Cerrar menú al tocar la hamburguesa
			if (btn && menu) {
				btn.addEventListener('click', () => {
					menu.classList.toggle('hidden');
				});
			}

			// Cerrar el menú automáticamente al hacer click en un link
			links.forEach(link => {
				link.addEventListener('click', () => {
					if (menu) {
						menu.classList.add('hidden');
					}
				});
			});

			// Actualizar la barra de progreso de scroll
			const progressBar = document.getElementById('scroll-progress');
			window.addEventListener('scroll', () => {
				const scrollTop = window.scrollY || document.documentElement.scrollTop;
				const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
				if (scrollHeight > 0 && progressBar) {
					const progressPercent = (scrollTop / scrollHeight) * 100;
					progressBar.style.width = `${progressPercent}%`;
				}
			}, { passive: true });

			// Resaltado de la sección activa (Scroll Spy)
			const navLinks = document.querySelectorAll('.nav-link');
			const sections = document.querySelectorAll('section[id], footer[id]');

			let isClickScrolling = false;
			let clickTimeout;

			const setActive = (currentId) => {
				navLinks.forEach(link => {
					const href = link.getAttribute('href');
					if (href === `#${currentId}`) {
						link.classList.add('text-blue-500', 'font-semibold');
						link.classList.remove('text-zinc-400');
					} else {
						link.classList.remove('text-blue-500', 'font-semibold');
						link.classList.add('text-zinc-400');
					}
				});
			};

			// Intersection Observer para detectar sección visible con precisión
			const observer = new IntersectionObserver((entries) => {
				if (isClickScrolling) return;

				entries.forEach(entry => {
					if (entry.isIntersecting) {
						setActive(entry.target.id);
					}
				});
			}, {
				rootMargin: '-20% 0px -50% 0px'
			});

			sections.forEach(sec => observer.observe(sec));

			// Al hacer scroll, si llegamos al fondo absoluto de la página, activar Contacto
			window.addEventListener('scroll', () => {
				if (isClickScrolling) return;

				const scrollPosition = window.innerHeight + window.scrollY;
				const threshold = document.documentElement.offsetHeight - 50;
				if (scrollPosition >= threshold) {
					setActive('contacto');
				}
			}, { passive: true });

			// Al hacer click en cualquier enlace, resaltar de inmediato y pausar el observer durante el viaje
			navLinks.forEach(link => {
				link.addEventListener('click', () => {
					const targetId = link.getAttribute('href')?.replace('#', '');
					if (targetId) {
						setActive(targetId);
						isClickScrolling = true;
						clearTimeout(clickTimeout);
						clickTimeout = setTimeout(() => {
							isClickScrolling = false;
						}, 800);
					}
				});
			});
		</script>
	</body>
</html>

<style is:global>
	.font-mono {
		font-family: 'JetBrains Mono', monospace;
	}
</style>