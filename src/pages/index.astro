---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Martín | Backend Developer">
	
	<!-- 1. HERO SECTION -->
	<section id="inicio" class="mb-24 pt-4 scroll-mt-24">
		<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-sm font-medium text-zinc-300 mb-6">
			<span class="relative flex h-2 w-2">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
				<span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
			</span>
			Open to work
		</div>

		<h1 class="text-4xl md:text-5xl font-bold text-zinc-100 mb-4 tracking-tight">
			Hola, soy <span class="text-blue-500">Martín</span>.
		</h1>
		<h2 class="text-xl md:text-2xl text-zinc-400 mb-8">
			Backend Developer especializado en Java y Spring Boot.
		</h2>

		<!-- IDE Snippet -->
		<div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5 font-mono text-xs md:text-sm mb-8 shadow-xl overflow-x-auto">
			<span class="text-zinc-500">// Spring Boot REST Controller</span><br/>
			<span class="text-blue-400">@RestController</span><br/>
			<span class="text-blue-400">@RequestMapping</span>(<span class="text-green-400">"/api/v1/martin"</span>)<br/>
			<span class="text-pink-500">public class</span> <span class="text-yellow-200">DeveloperController</span> &#123;<br/>
			<br/>
			&nbsp;&nbsp;<span class="text-blue-400">@GetMapping</span>(<span class="text-green-400">"/profile"</span>)<br/>
			&nbsp;&nbsp;<span class="text-pink-500">public</span> <span class="text-teal-300">ResponseEntity</span>&lt;<span class="text-teal-300">DevProfile</span>&gt; <span class="text-yellow-100">getProfile</span>() &#123;<br/>
			&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-pink-500">return</span> <span class="text-teal-300">ResponseEntity</span>.ok(<br/>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-teal-300">DevProfile</span>.builder()<br/>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.focus(<span class="text-green-400">"APIs REST escalables y código mantenible"</span>)<br/>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.mainStack(<span class="text-teal-300">List</span>.of(<span class="text-green-400">"Java"</span>, <span class="text-green-400">"Spring Boot"</span>, <span class="text-green-400">"PostgreSQL"</span>, <span class="text-green-400">"Docker"</span>))<br/>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.openToWork(<span class="text-pink-500">true</span>)<br/>
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;.build()<br/>
			&nbsp;&nbsp;&nbsp;&nbsp;);<br/>
			&nbsp;&nbsp;&#125;<br/>
			&#125;
		</div>

		<!-- Botones de Acción -->
		<div class="flex flex-wrap gap-4 mb-16">
			<a href="https://drive.google.com/file/d/1XhynRwRLLYR9Y--njcLH6V7nUmVxabmU/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-md font-medium transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
				Ver CV
			</a>
			<a href="https://www.linkedin.com/in/martinnzx/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-zinc-900 border border-zinc-700 hover:border-zinc-500 text-zinc-300 px-6 py-2.5 rounded-md font-medium transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
				LinkedIn
			</a>
			<a href="https://github.com/martinnzx" target="_blank" class="flex items-center gap-2 bg-zinc-900 border border-zinc-700 hover:border-zinc-500 text-zinc-300 px-6 py-2.5 rounded-md font-medium transition-colors">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
				GitHub
			</a>
		</div>

		<!-- Scroll Indicator Creativo -->
		<div class="flex justify-center pt-4">
			<a 
				href="#sobre-mi" 
				class="group flex flex-col items-center gap-2 text-zinc-500 hover:text-blue-400 transition-colors"
			>
				<span class="text-xs font-mono uppercase tracking-widest text-zinc-500 group-hover:text-blue-400 transition-colors">
					Desplázate para explorar
				</span>
				
				<!-- Mouse animado con rueda que baja -->
				<div class="w-5 h-8 rounded-full border-2 border-zinc-700 group-hover:border-blue-500/60 transition-colors flex justify-center pt-1.5">
					<div class="w-1 h-1.5 bg-blue-500 rounded-full animate-bounce"></div>
				</div>

				<!-- Flecha flotante hacia abajo -->
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="translate-y-0 group-hover:translate-y-1 transition-transform text-zinc-600 group-hover:text-blue-400">
					<path d="m6 9 6 6 6-6"/>
				</svg>
			</a>
		</div>
	</section>

	<div class="w-full h-px bg-gradient-to-r from-zinc-950 via-zinc-800 to-zinc-950 my-20"></div>

	<!-- 2. SOBRE MÍ -->
	<section id="sobre-mi" class="mb-24 scroll-mt-24">
		<h3 class="text-2xl font-bold text-zinc-100 mb-6">Sobre Mí</h3>
		<div class="bg-zinc-900/50 p-6 md:p-8 rounded-xl border border-zinc-800/50 flex flex-col md:flex-row items-center gap-8">
			<div class="relative shrink-0">
				<div class="w-28 h-28 md:w-32 md:h-32 rounded-full p-1 bg-gradient-to-tr from-blue-600 via-blue-500/30 to-zinc-800 shadow-xl shadow-blue-950/20">
					<img 
						src="/perfil.jpg" 
						alt="Foto de Martín Mamani" 
						class="w-full h-full object-cover rounded-full bg-zinc-950"
					/>
				</div>
			</div>
			<p class="text-zinc-400 leading-relaxed text-sm md:text-base">
				Soy un Desarrollador Backend especializado en Java y Spring Boot, y estudiante avanzado de la carrera Analista Programador Universitario (UNJu). Me enfoco en crear soluciones sólidas que priorizan la seguridad, la escalabilidad y un código fácil de mantener.
				Diseño APIs REST limpias y eficientes, implementando esquemas de autenticación con Spring Security + JWT, e integrando PostgreSQL y Docker como parte de mi stack tecnológico.
			</p>
		</div>
	</section>

	<div class="w-full h-px bg-gradient-to-r from-zinc-950 via-zinc-800 to-zinc-950 my-20"></div>

	<!-- 3. STACK TECNOLÓGICO -->
	<section id="stack" class="mb-24 scroll-mt-24 text-center">
		<h3 class="text-2xl font-bold text-zinc-100 mb-2">Stack Tecnológico</h3>
		<p class="text-zinc-400 text-sm mb-8">Tecnologías y herramientas que utilizo habitualmente</p>
		
		<div class="space-y-12">
			<div>
				<h4 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-6">Principal (Backend)</h4>
				<div class="flex flex-wrap justify-center gap-8">
					{[
						{ name: 'Java', icon: 'devicon-java-plain colored' },
						{ name: 'Spring Boot', icon: 'devicon-spring-original colored' },
						{ name: 'PostgreSQL', icon: 'devicon-postgresql-plain colored' },
						{ name: 'Docker', icon: 'devicon-docker-plain colored' },
						{ name: 'JUnit 5', icon: '' }
					].map(tech => (
						<div class="flex flex-col items-center gap-2 transition-transform hover:scale-110">
							{tech.icon ? 
								<i class={`${tech.icon} text-5xl`}></i> 
								: 
								<div class="h-[48px] flex items-center justify-center font-bold text-xl text-green-500 border-2 border-green-500/50 rounded-lg px-2">J5</div>
							}
							<span class="text-sm text-zinc-300 font-medium">{tech.name}</span>
						</div>
					))}
				</div>
			</div>
			
			<div>
				<h4 class="text-sm font-semibold text-zinc-400 uppercase tracking-wider mb-6">Secundario (Fullstack)</h4>
				<div class="flex flex-wrap justify-center gap-8">
					{[
						{ name: 'TypeScript', icon: 'devicon-typescript-plain colored' },
						{ name: 'Angular', icon: 'devicon-angularjs-plain colored' },
						{ name: 'Node.js', icon: 'devicon-nodejs-plain-wordmark colored' },
						{ name: 'Express', icon: 'devicon-express-original text-zinc-100' },
						{ name: 'Bootstrap', icon: 'devicon-bootstrap-plain colored' }
					].map(tech => (
						<div class="flex flex-col items-center gap-2 transition-transform hover:scale-110">
							<i class={`${tech.icon} text-5xl`}></i>
							<span class="text-sm text-zinc-300 font-medium">{tech.name}</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<div class="w-full h-px bg-gradient-to-r from-zinc-950 via-zinc-800 to-zinc-950 my-20"></div>

	<!-- 4. PROYECTOS -->
	<section id="proyectos" class="mb-24 scroll-mt-24">
		<h3 class="text-2xl font-bold text-zinc-100 mb-6">Proyectos Destacados</h3>
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
			
			<article class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden group flex flex-col justify-between">
				<div>
					<!-- Imagen del Proyecto -->
					<div class="w-full h-44 overflow-hidden border-b border-zinc-800/80 bg-zinc-950">
						<img 
							src="/proyectos/logistica.png" 
							alt="Vista previa Sistema de Logística de Envíos" 
							class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
						/>
					</div>

					<div class="p-5 md:p-6">
						<h4 class="text-lg font-bold text-zinc-100 mb-2">API REST — Sistema de Logística 🚚</h4>
						<p class="text-zinc-400 text-xs md:text-sm leading-relaxed mb-4">
							Plataforma integral para gestionar el ciclo de vida de paquetería y flotas, validando restricciones físicas estrictas (cadena de frío, peso, fragilidad).
						</p>
						
						<div class="mb-5 bg-zinc-950/40 p-3 rounded-lg border border-zinc-800/50">
							<h5 class="text-xs font-bold text-zinc-300 mb-1">Arquitectura & Decisiones</h5>
							<p class="text-zinc-400 text-xs leading-relaxed">
								Arquitectura en capas y Spec Driven Development (SDD). Patrón State, interfaces desacopladas, migraciones con Flyway y Docker.
							</p>
						</div>

						<div class="flex flex-wrap gap-2 mb-4">
							{[
								{ name: 'Java', icon: 'devicon-java-plain colored' },
								{ name: 'Spring Boot', icon: 'devicon-spring-original colored' },
								{ name: 'PostgreSQL', icon: 'devicon-postgresql-plain colored' },
								{ name: 'Docker', icon: 'devicon-docker-plain colored' }
							].map(tech => (
								<span class="flex items-center gap-1.5 text-xs font-mono text-zinc-400 bg-zinc-950/70 px-2 py-1 rounded border border-zinc-800/80">
									{tech.icon && <i class={`${tech.icon} text-xs`}></i>}
									{tech.name}
								</span>
							))}
						</div>
					</div>
				</div>

				<div class="p-5 md:p-6 pt-0">
					<a href="https://github.com/martinnzx/sistema-logistica-api" target="_blank" class="text-sm font-medium text-blue-400 hover:text-blue-300 flex items-center gap-1 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
						Ver Repositorio
					</a>
				</div>
			</article>

			<article class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden group flex flex-col justify-between">
				<div>
					<!-- Imagen del Proyecto -->
					<div class="w-full h-44 overflow-hidden border-b border-zinc-800/80 bg-zinc-950">
						<img 
							src="/proyectos/gymhub.png" 
							alt="Vista previa GymHub — Sistema para Gimnasios" 
							class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
						/>
					</div>

					<div class="p-5 md:p-6">
						<h4 class="text-lg font-bold text-zinc-100 mb-2">GymHub — Gestión para Gimnasios 🏋️</h4>
						<p class="text-zinc-400 text-xs md:text-sm leading-relaxed mb-4">
							Digitalización de usuarios, rutinas, suscripciones y cobros. Plataforma integral con autenticación, roles y pagos automáticos.
						</p>
						
						<div class="mb-5 bg-zinc-950/40 p-3 rounded-lg border border-zinc-800/50">
							<h5 class="text-xs font-bold text-zinc-300 mb-1">Arquitectura & Decisiones</h5>
							<p class="text-zinc-400 text-xs leading-relaxed">
								Frontend modular en Angular con Guards. Backend MVC con Express, Sequelize, Google OAuth, MercadoPago API y Resend.
							</p>
						</div>

						<div class="flex flex-wrap gap-2 mb-4">
							{[
								{ name: 'TypeScript', icon: 'devicon-typescript-plain colored' },
								{ name: 'Angular', icon: 'devicon-angularjs-plain colored' },
								{ name: 'Node.js', icon: 'devicon-nodejs-plain-wordmark colored' },
								{ name: 'Express', icon: 'devicon-express-original text-zinc-100' },
								{ name: 'Sequelize', icon: 'devicon-sequelize-plain colored' },
								{ name: 'MercadoPago API', icon: '' }
							].map(tech => (
								<span class="flex items-center gap-1.5 text-xs font-mono text-zinc-400 bg-zinc-950/70 px-2 py-1 rounded border border-zinc-800/80">
									{tech.icon && <i class={`${tech.icon} text-xs`}></i>}
									{tech.name}
								</span>
							))}
						</div>
					</div>
				</div>

				<div class="p-5 md:p-6 pt-0 flex flex-wrap gap-4">
					<a href="https://gymhub-app.vercel.app/home" target="_blank" class="text-sm font-medium text-blue-400 hover:text-blue-300 flex items-center gap-1 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
						Demo en Vivo
					</a>
					<a href="https://github.com/martinnzx/proybackendgrupoG06" target="_blank" class="text-sm font-medium text-zinc-400 hover:text-zinc-300 flex items-center gap-1 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
						Backend
					</a>
					<a href="https://github.com/martinnzx/proyfrontendgrupoG06" target="_blank" class="text-sm font-medium text-zinc-400 hover:text-zinc-300 flex items-center gap-1 transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
						Frontend
					</a>
				</div>
			</article>
		</div>
	</section>

	<div class="w-full h-px bg-gradient-to-r from-zinc-950 via-zinc-800 to-zinc-950 my-20"></div>

	<!-- 5. EDUCACIÓN  -->
	<section id="educacion" class="mb-24 scroll-mt-24">
		<h3 class="text-2xl font-bold text-zinc-100 mb-6">Educación y Certificaciones</h3>
		
		<div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 md:p-8 relative overflow-hidden">
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-3">
				<h4 class="text-lg md:text-xl font-bold text-zinc-100">Analista Programador Universitario</h4>
				<span class="inline-flex items-center text-xs font-mono px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-500 border border-blue-500/20 self-start md:self-auto font-medium">
					2024 — En curso
				</span>
			</div>
			
			<p class="text-sm font-medium text-blue-500 mb-4 flex items-center gap-1.5">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
				Facultad de Ingeniería (UNJu) — San Salvador de Jujuy
			</p>
			
			<p class="text-zinc-400 text-sm leading-relaxed">
				Formación en análisis de sistemas, bases de datos y fundamentos de programación, combinando conocimientos teóricos con aplicación práctica.
			</p>
		</div>
	</section>

	<div class="w-full h-px bg-gradient-to-r from-zinc-950 via-zinc-800 to-zinc-950 my-20"></div>

	<!-- 6. CONTACTO -->
	<section id="contacto" class="mb-24 scroll-mt-24">
		<h3 class="text-2xl font-bold text-zinc-100 mb-2">Hablemos</h3>
		<p class="text-zinc-400 text-sm mb-8">
			Estoy abierto a nuevos proyectos y oportunidades para aprender, crecer y aportar valor.
		</p>

		<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
			<!-- GitHub -->
			<a 
				href="https://github.com/martinnzx" 
				target="_blank" 
				rel="noopener noreferrer"
				class="flex items-center gap-3.5 p-4 rounded-xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-800/60 transition-all group"
			>
				<div class="p-2.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-400 group-hover:text-blue-500 group-hover:border-blue-500/30 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
				</div>
				<div class="overflow-hidden">
					<span class="text-xs text-zinc-500 block font-medium">GitHub</span>
					<span class="text-sm font-semibold text-zinc-200 group-hover:text-blue-400 transition-colors truncate block">@martinnzx</span>
				</div>
			</a>

			<!-- LinkedIn -->
			<a 
				href="https://www.linkedin.com/in/martinnzx/" 
				target="_blank" 
				rel="noopener noreferrer"
				class="flex items-center gap-3.5 p-4 rounded-xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-800/60 transition-all group"
			>
				<div class="p-2.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-400 group-hover:text-blue-500 group-hover:border-blue-500/30 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
				</div>
				<div class="overflow-hidden">
					<span class="text-xs text-zinc-500 block font-medium">LinkedIn</span>
					<span class="text-sm font-semibold text-zinc-200 group-hover:text-blue-400 transition-colors truncate block">Martin Mamani</span>
				</div>
			</a>

			<!-- Email (Protegido contra scrapers de spam) -->
			<button 
				id="copy-email-btn"
				type="button"
				class="flex items-center gap-3.5 p-4 rounded-xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-800/60 transition-all group text-left cursor-pointer w-full"
			>
				<div id="email-icon-box" class="p-2.5 rounded-lg bg-zinc-950 border border-zinc-800 text-zinc-400 group-hover:text-blue-500 group-hover:border-blue-500/30 transition-colors shrink-0">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
				</div>
				<div class="overflow-hidden flex-1">
					<span class="text-xs text-zinc-500 block font-medium">Email</span>
					<span id="email-label" class="text-sm font-semibold text-zinc-200 group-hover:text-blue-400 transition-colors truncate block">
						Copiar correo
					</span>
				</div>
			</button>
		</div>
	</section>

	<!-- Script de protección y copiado al portapapeles -->
	<script>
		const copyBtn = document.getElementById('copy-email-btn');
		const emailLabel = document.getElementById('email-label');
		const emailIconBox = document.getElementById('email-icon-box');

		// El email se ensambla dinámicamente con JS en el cliente, evitando que bots lo extraigan del HTML estático
		const user = "martinnnxz";
		const domain = "gmail.com";
		const fullEmail = `${user}@${domain}`;

		copyBtn?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(fullEmail);
				if (emailLabel && emailIconBox) {
					emailLabel.textContent = "¡Copiado!";
					emailLabel.classList.add("text-blue-400");
					emailIconBox.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><polyline points="20 6 9 17 4 12"/></svg>`;

					setTimeout(() => {
						emailLabel.textContent = "Copiar correo";
						emailLabel.classList.remove("text-blue-400");
						emailIconBox.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`;
					}, 2000);
				}
			} catch (err) {
				// Fallback si el portapapeles no responde
				window.location.href = `mailto:${fullEmail}`;
			}
		});
	</script>

	<!-- FOOTER -->
	<footer class="border-t border-zinc-800/80 pt-8 mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 pb-8 text-zinc-500 text-xs">
		<p>© {new Date().getFullYear()} Martín Mamani.</p>
		<p>Hecho con pasión y mucho mate 🧉</p>
	</footer>

</Layout>